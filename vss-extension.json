{
  "manifestVersion": 1,
  "id": "safe-ado",
  "publisher": "SAFeADO",
  "version": "1.1.0",
  "public": true,
  "name": "SAFe Ado",
  "description": "Scaled Agile Framework (SAFe) for Azure DevOps: Portfolio, Large Solution, ART and Team hierarchy, Program Board, PI Objectives, ROAM risks, PI management and reports.",
  "categories": ["Azure Boards"],
  "tags": ["SAFe", "PI Planning", "ART", "Program Board", "Portfolio", "Scaled Agile"],
  "targets": [
    { "id": "Microsoft.VisualStudio.Services" }
  ],
  "icons": { "default": "images/logo.png" },
  "content": { "details": { "path": "overview.md" } },
  "repository": { "type": "git", "uri": "https://github.com/eslam-sa3d/safe-ado" },
  "links": {
    "repository": { "uri": "https://github.com/eslam-sa3d/safe-ado" },
    "support": { "uri": "https://github.com/eslam-sa3d/safe-ado/issues" }
  },
  "scopes": ["vso.work_write", "vso.project"],
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "images", "addressable": true }
  ],
  "contributions": [
    {
      "id": "safe-hub",
      "type": "ms.vss-web.hub",
      "targets": ["ms.vss-work-web.work-hub-group"],
      "properties": {
        "name": "SAFe",
        "uri": "dist/hub.html",
        "iconName": "Org",
        "order": 99
      }
    },
    {
      "id": "safe-work-item-form-group",
      "type": "ms.vss-work-web.work-item-form-group",
      "description": "SAFe unit, PI, hierarchy and planning data of the work item.",
      "targets": ["ms.vss-work-web.work-item-form"],
      "properties": {
        "name": "SAFe",
        "uri": "dist/form.html",
        "height": 260
      }
    }
  ]
}
